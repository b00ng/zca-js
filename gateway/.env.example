# ===== Bắt buộc =====
# API key cho ứng dụng gọi vào gateway (>= 24 ký tự). Nhiều key: API_KEYS=key1,key2
# Tạo key: openssl rand -hex 32
API_KEY=

# ===== Người nhận đặt tên (alias) =====
# Ứng dụng chỉ cần gửi "to": "ops-alerts" thay vì nhớ ID. Có thể dùng file /data/aliases.json thay thế.
# ALIASES={"ops-alerts":{"type":"group","id":"1234567890123456789"},"truong-ca":{"type":"user","id":"9876543210987654321"}}

# ===== Chống bị khoá tài khoản: giãn cách giữa các tin nhắn =====
SEND_MIN_INTERVAL_MS=1500
SEND_JITTER_MS=1000
SEND_MAX_QUEUE=200
SEND_TIMEOUT_MS=60000

# ===== File đính kèm =====
ATTACHMENT_MAX_MB=25
ATTACHMENT_MAX_COUNT=10
ATTACHMENT_ALLOW_URL=true
# Giới hạn kích thước body JSON (base64 làm file to thêm ~33%)
BODY_MAX_MB=40

# ===== Nhận tin nhắn đến (listener + webhook) =====
# Listener cần cho: gửi file không phải ảnh (pdf, xlsx, mp4...), webhook, /v1/threads/recent
ENABLE_LISTENER=true
# WEBHOOK_URL=http://my-ops-app.tailnet-name.ts.net/zalo/webhook
# WEBHOOK_SECRET=
WEBHOOK_INCLUDE_SELF=false

# ===== Khác =====
LOG_LEVEL=info
ZALO_LOGGING=false
# ZALO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# ===== Chỉ dùng khi chạy kèm docker-compose.tailscale.yml =====
# Auth key tạo tại https://login.tailscale.com/admin/settings/keys (nên chọn Reusable + Tags)
# TS_AUTHKEY=tskey-auth-xxxxx
# TS_HOSTNAME=zalo-gateway
# TS_EXTRA_ARGS=--advertise-tags=tag:zalo-gateway
